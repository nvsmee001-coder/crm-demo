# Copy to .env and chmod 600 .env. Never commit/send the real .env.
# Use a real domain without scheme, path or port.
APP_DOMAIN=crm.example.com
APP_ORIGIN=https://crm.example.com
SMEE_OWNER_EMAIL=owner@example.com
# Generate a URL-safe password: openssl rand -hex 32
# Hex characters avoid DATABASE_URL escaping and Compose interpolation problems.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# DATABASE_URL is composed internally by compose.yaml; PostgreSQL has no published port.
# Owner login password is entered by npm run owner:create, never stored in this file.

# Existing host Nginx: uncomment both lines and follow README-VPS section 1a.
# COMPOSE_FILE=compose.nginx.yaml
# SMEE_HTTP_PORT=3180
